def setGitHubCommitStatus(String message, String state) {
    step([
        $class: 'GitHubCommitStatusSetter',

        reposSource: [
            $class: 'AnyDefinedRepositorySource'
        ],

        commitShaSource: [
            $class: 'BuildDataRevisionShaSource'
        ],

        contextSource: [
            $class: 'ManuallyEnteredCommitContextSource',
            context: 'Connectly CI Pipeline'
        ],

        errorHandlers: [
            [$class: 'ShallowAnyErrorHandler']
        ],

        statusResultSource: [
            $class: 'ConditionalStatusResultSource',
            results: [
                [
                    $class: 'AnyBuildResult',
                    message: message,
                    state: state
                ]
            ]
        ]
    ])
}

pipeline {
    agent any

    tools {
        jdk 'JDK21'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
            numToKeepStr: '10'
        ))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'Connectly source code checked out.'
            }
        }

        stage('Notify GitHub - Build Started') {
            steps {
                script {
                    setGitHubCommitStatus(
                        'Jenkins pipeline is running.',
                        'PENDING'
                    )
                }
            }
        }

        stage('Verify Environment') {
            steps {
                bat 'java -version'
                bat 'git --version'
            }
        }

        stage('Build and Test') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'connectly-db-username',
                        variable: 'DB_USERNAME'
                    ),
                    string(
                        credentialsId: 'connectly-db-password',
                        variable: 'DB_PASSWORD'
                    ),
                    string(
                        credentialsId: 'connectly-jwt-secret',
                        variable: 'JWT_SECRET'
                    )
                ]) {
                    dir('backend') {
                        bat 'gradlew.bat clean test'
                    }
                }
            }

            post {
                always {
                    junit(
                        testResults: 'backend/build/test-results/test/*.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('JaCoCo Coverage Verification') {
            steps {
                dir('backend') {
                    bat 'gradlew.bat jacocoTestCoverageVerification'
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'backend/build/reports/jacoco/test/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('ConnectlySonarQube') {
                    dir('backend') {
                        bat 'gradlew.bat sonar --stacktrace --info -Dsonar.scanner.skipJreProvisioning=true -Dsonar.token=%SONAR_AUTH_TOKEN%'
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qualityGate = waitForQualityGate()

                        if (qualityGate.status != 'OK') {
                            error "SonarQube Quality Gate failed: ${qualityGate.status}"
                        }

                        echo 'SonarQube Quality Gate passed.'
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Connectly CI pipeline completed successfully.'

            script {
                setGitHubCommitStatus(
                    'Build, tests, coverage and SonarQube quality gate passed.',
                    'SUCCESS'
                )
            }
        }

        failure {
            echo 'Connectly CI pipeline failed. Check the stage logs.'

            script {
                setGitHubCommitStatus(
                    'Build or quality checks failed. Check Jenkins logs.',
                    'FAILURE'
                )
            }
        }

        aborted {
            echo 'Connectly CI pipeline was aborted.'

            script {
                setGitHubCommitStatus(
                    'Jenkins pipeline was aborted.',
                    'ERROR'
                )
            }
        }

        always {
            echo 'Connectly pipeline execution finished.'
        }
    }
}

